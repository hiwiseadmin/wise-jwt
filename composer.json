{
    "name": "wiseadmin/wise-jwt",
    "description": "WiseAdmin JWT 令牌管理包 — 签发/校验/吊销/续签，支持 HMAC/RSA/ECDSA/EdDSA，生产级方案",
    "type": "library",
    "license": "MIT",
    "keywords": ["wiseadmin", "thinkphp", "jwt", "auth", "token"],
    "require": {
        "php": ">=8.1",
        "topthink/framework": "^6.0 || ^8.0",
        "ext-json": "*",
        "ext-openssl": "*"
    },
    "require-dev": {
        "phpunit/phpunit": ">=9.0",
        "mockery/mockery": ">=1.0"
    },
    "autoload": {
        "psr-4": {
            "wise\\jwt\\": "src/"
        },
        "files": [
            "src/helper.php"
        ]
    },
    "extra": {
        "think": {
            "services": [
                "wise\\jwt\\Service"
            ],
            "config": {
                "wise-jwt": "config/wise-jwt.php"
            }
        }
    }
}
